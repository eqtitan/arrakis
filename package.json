{
  "name": "arrakis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "vite build && wrangler pages dev dist --compatibility-date=2025-07-18 --port=8789",
    "typecheck": "tsc --noEmit",
