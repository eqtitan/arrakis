  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250718.0",
    "esbuild": "^0.24.2",
    "three": "^0.149.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^3.90.0"
  }
}
