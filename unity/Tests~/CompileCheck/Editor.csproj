<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check for the editor scripts (build script, project setup) against UnityEditor API
       stubs (Stubs/Editor) written from Unity's C# reference source for 6000.0. See Client.csproj. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sigilbound.Editor</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414;CS0618;CS0169;CS1998;CS0436</NoWarn>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;SB_URP;SB_GLTFAST;SB_COMPILE_CHECK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" Condition="'$(UnityManaged)' == ''" />
    <ProjectReference Include="Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Sigilbound/Editor/**/*.cs" />
    <Compile Include="Stubs/Editor/**/*.cs" Condition="'$(UnityManaged)' == ''" />
  </ItemGroup>
  <!-- With -p:UnityManaged=<dir> (Unity's Editor/Data/Managed, see unity/Tools~/unity-refs), compile
       against the real Unity 6 assemblies instead of the 2021.3 nuget modules and editor stubs. -->
  <PropertyGroup Condition="'$(UnityManaged)' != ''">
    <DefineConstants>$(DefineConstants);SB_REAL_UNITY_REFS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UnityManaged)' != ''">
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" Private="false" />
  </ItemGroup>
</Project>
