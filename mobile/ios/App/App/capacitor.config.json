			"style": "DARK",
			"backgroundColor": "#14111c",
			"overlaysWebView": false
		}
	},
	"packageClassList": [
		"AppPlugin",
		"HapticsPlugin",
		"PreferencesPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
