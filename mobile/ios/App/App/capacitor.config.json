{
	"appId": "com.sigilbound.game",
	"appName": "Sigilbound",
	"webDir": "www",
	"backgroundColor": "#14111c",
	"android": {
		"backgroundColor": "#14111c"
	},
	"ios": {
		"backgroundColor": "#14111c",
		"contentInset": "never"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#14111c",
			"showSpinner": false
